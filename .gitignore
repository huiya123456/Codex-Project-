# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*.swo
*~
.vscode/
.idea/

# Local runtime/config files that should not be shared
.env
.env.*
local.config.*
*.local
*.secret
secrets/

# Logs and local reports
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency/build caches if tooling is added
node_modules/
dist/
build/
.cache/
.parcel-cache/
.turbo/
coverage/

# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# PowerShell/local script output
*.ps1xml
*.pssc
*.psd1.local

# Generated media/model artifacts that should be explicitly opted in
*.ckpt
*.safetensors
*.pt
*.pth
*.onnx
*.gguf
*.mp4
*.mov
*.avi
*.zip
*.7z
*.rar
